{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "FileStorage": {
    "BasePath": "wwwroot/FileStorage"
  },

  "Storage": {
    "Type": "local",
    "BaseUrl": "",
    "LocalBaseDir": "wwwroot/FileStorage",
    "S3": {
      "BucketName": "your-s3-bucket",
      "Region": "us-east-1"
    },
    "Azure": {
      "AccountName": "schedulerfilestorage",
      "ContainerName": "filestorage"
    },
    "GCP": {
      "BucketName": "your-gcp-bucket"
    }
  },

  "Stripe": {
    "SecretKey": "",
    "SaaSAdmin": {
      "SecretKey": "",
      "PublishableKey": "",
      "Description": "SaaS Admin Stripe account for charging organizations for packages"
    }
  },

  "Email": {
    "Provider": "AwsSes",
    "Region": "us-east-1",
    "FromEmail": "noreply@caresynx.com",
    "FromDisplayName": "caresynX",
    "AdminEmail": "admin@caresynx.com",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": "",
      "UseDefaultCredentials": false,
      "Timeout": 30000
    }
  },

  "Environment": "Production"
