[Unit]
Description=CaresynX Scheduler MCP (stdio + HTTP bridge)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/caresynx/mcp
Environment=NODE_ENV=production
# Create /opt/caresynx/mcp/.env on the server (not deployed from CI). See .env.example.
EnvironmentFile=-/opt/caresynx/mcp/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
